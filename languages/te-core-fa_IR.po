msgstr "مربع (۱:۱)"

msgid "Portrait (4:5)"
msgstr "عمودی (۴:۵)"

msgid "Tall (3:4)"
msgstr "بلند (۳:۴)"

msgid "Image fit"
msgstr "جا شدن تصویر"

msgid "Contain keeps the whole product visible. Cover fills the frame."
msgstr "Contain کل کالا را نشان می‌دهد. Cover قاب را پر می‌کند."

msgid "Contain"
msgstr "کامل در قاب"

msgid "Cover"
msgstr "پر کردن قاب"

msgid "Ratings on cards"
msgstr "امتیاز روی کارت"

msgid "Category on cards"
msgstr "دسته روی کارت"

